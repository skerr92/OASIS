#!/usr/bin/env sh
set -eu

TARGET=oasis16-elf-gcc

if [ -n "${OASIS_TOOLCHAIN_PREFIX:-}" ] && [ -x "$OASIS_TOOLCHAIN_PREFIX/bin/$TARGET" ]; then
  exec "$OASIS_TOOLCHAIN_PREFIX/bin/$TARGET" "$@"
fi

cat >&2 <<'EOF'
oasis-cc: no installed OASIS C compiler found.

Build or install the oasis16-unknown-elf toolchain, then set:

  OASIS_TOOLCHAIN_PREFIX=/path/to/oasis16

Expected compiler:

  $OASIS_TOOLCHAIN_PREFIX/bin/oasis16-elf-gcc

See toolchain/README.md for build scripts and validation.
EOF
exit 1
