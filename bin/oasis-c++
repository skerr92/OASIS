#!/usr/bin/env sh
set -eu

TARGET=oasis16-elf-g++

if [ -n "${OASIS_TOOLCHAIN_PREFIX:-}" ] && [ -x "$OASIS_TOOLCHAIN_PREFIX/bin/$TARGET" ]; then
  exec "$OASIS_TOOLCHAIN_PREFIX/bin/$TARGET" "$@"
fi

cat >&2 <<'EOF'
oasis-c++: no installed OASIS C++ compiler found.

C++ support is still behind the freestanding C bring-up path. When a C++ capable
toolchain exists, set:

  OASIS_TOOLCHAIN_PREFIX=/path/to/oasis16

Expected compiler:

  $OASIS_TOOLCHAIN_PREFIX/bin/oasis16-elf-g++

See toolchain/README.md for build scripts and validation.
EOF
exit 1
